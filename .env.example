# Copy these into Vercel → your project → Settings → Environment Variables.
# Never commit real secret values to GitHub.

# ── Supabase (Project Settings → API) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Stripe (already set up) ──
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_GROWER=price_...
STRIPE_PRICE_HARVEST=price_...
STRIPE_PRICE_BOOST_7=price_...
STRIPE_PRICE_BOOST_30=price_...

# ── Email (Resend) ──
RESEND_API_KEY=re_...
EMAIL_FROM=Homestead <hello@yourdomain.com>

# ── App ──
VITE_APP_URL=https://your-site.vercel.app
